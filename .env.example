# Usuario administrador autorizado con cuenta de Google (@cuatrovientos.org)
# Puedes indicar un único correo o varios separados por comas
ADMIN_USER=tu_correo@cuatrovientos.org

# Credenciales de Google OAuth2 (Google Cloud Console -> Credenciales -> ID de cliente OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dominio corporativo obligatorio
ALLOWED_DOMAIN=cuatrovientos.org

# Clave secreta para la sesión de Flask
SECRET_KEY=clave_secreta_para_firmar_cookies_de_sesion

# Base de datos SQLite
DATABASE_PATH=feedback.db
